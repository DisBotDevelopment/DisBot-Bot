  GuildId              String
  Guilds               Guilds               @relation(fields: [GuildId], references: [GuildId])
}

// UPDATE SOON - move to /moderation automod - Options Disocrd(Recommended!!!) DisBot
model GuildDisBotAutoModeration {
  Id             Int                                     @id @default(autoincrement())

generator client {
  provider      = "prisma-client-js"
  output        = "../src/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL")
}

// Guilds
model Guilds {
  Id                          Int                           @id @default(autoincrement())
  GuildId                     String                        @unique
  GuildName                   String
  GuildOwner                  String
  AutoAutoDeletes             GuildAutoDeletes[]
  AutoPublish                 GuildAutoPublish?
  AutoReacts                  GuildAutoReacts[]
  AutoRoles                   GuildAutoRoles[]
  GuildModeration             GuildModeration?
  GuildDisBotAutoModeration   GuildDisBotAutoModeration?
  DiscordAddons               DiscordGuildAddon?
  Giveaways                   Giveaways[]
  TempVoices                  TempVoices[]
  GuildLeaveSetup             GuildLeaveSetup?
  GuildLogging                GuildLogging?
  MessageTemplates            MessageTemplates[]
  ReactionRole                GuildReactionRoles[]
  Security                    GuildSecurity?
  SpotifyNotifications        GuildSpotifyNotifications[]
  Tags                        Tags[]
  Polls                       Polls[]
  TicketSetups                TicketSetups[]
  GuildFeatureToggle          GuildFeatureToggles?
  TwitchNotifications         GuildTwitchNotifications[]
  GuildWelcomeSetup           GuildWelcomeSetup?
  YoutubeNotifications        GuildYoutubeNotifications[]
  GuildLogs                   GuildLogs[]
  GuildInteractionPermissions GuildInteractionPermissions[]
  GuildCommandManger          GuildCommandManger?
  GuildComponentManager       GuildComponentManager?
  GuildChannelLinks           GuildChannelLinks[]
  ModerationScout             ModerationScout?
  GuildUserModeration         GuildUserModeration[]
  LevelSettings               LevelSettings?
}

model GuildCommandManger {
  Id               Int               @id @default(autoincrement())
  Commands         Json[] // SOON
  SubCommands      Json[] // SOON
  SubCommandGroups Json[] // SOON
  ContextMenus     Json[] // SOON
  BuildInCommands  BuildInCommands[]
  GuildId          String            @unique
  Guilds           Guilds            @relation(fields: [GuildId], references: [GuildId])
}

model BuildInCommands {
  Id                   Int                @id @default(autoincrement())
  UUID                 String             @unique
  CustomName           String
  Description          String?
  Permissions          String?
  IsEnabled            Boolean?           @default(false)
  CodeName             String // Command: <name> | SubCommand: <name>.<subCommand> | SubCommandGroup: <name>.<subCommand>.<subCommandGroup> | ContextMenu: <name>
  GuildCommandMangerId String
  GuildCommandMangers  GuildCommandManger @relation(fields: [GuildCommandMangerId], references: [GuildId])
}

model GuildComponentManager {
  Id          Int    @id @default(autoincrement())
  Selectmenus Json[] // SOON
  Buttons     Json[] // SOON
  Modals      Json[] // SOON
  GuildId     String @unique
  Guilds      Guilds @relation(fields: [GuildId], references: [GuildId])
}

model GuildInteractionPermissions {
  Id                            Int      @id @default(autoincrement())
  UUID                          String   @unique
  RoleIds                       String[]
  UserIds                       String[]
  ChannelIds                    String[]
  CustomId                      String?
  CommandName                   String?
  Type                          String // BUTTON, SELECTMENU, COMMAND, SUBCOMMAND, SUBCOMMANDGROUP, MODAL (GuildPermissionType)
  DisableInternalUserPermission Boolean? @default(false)
  NeedsGuildOwner               Boolean?
  Cooldown                      Int?
  GuildId                       String
  Guilds                        Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoDeletes {
  Id                  Int      @id @default(autoincrement())
  ChannelId           String?
  IsActive            Boolean?
  Time                String?
  UUID                String?  @unique
  WhitelistedMessages String[]
  WhitelistedRoles    String[]
  WhitelistedUsers    String[]
  GuildId             String
  Guilds              Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoPublish {
  Id       Int      @id @default(autoincrement())
  Channels String[]
  GuildId  String   @unique
  Guilds   Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoReacts {
  Id        Int    @id @default(autoincrement())
  ChannelId String
  Emoji     String
  GuildId   String
  Guilds    Guilds @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoRoles {
  Id      Int    @id @default(autoincrement())
  RoleId  String
  GuildId String
  Guilds  Guilds @relation(fields: [GuildId], references: [GuildId])
}

model ModerationScout {
  Id                             Int                              @id @default(autoincrement())
  UUID                           String                           @unique
  PublicBanListUrl               String?                          @default("https://api.disbot.app/v2/banList")
  AdminBanList                   Json // Only for the Guild set in the Config
  CurrentUserModerations         Json[] // Storage for Bans, Wans, Mutes, Kicks (Alos you can create a custom one!)
  PublicBanListEnabled           Boolean                          @default(false)
  NeedsModeratorApprove          Boolean
  ModeratorRoles                 String[]
  // Appeals
  UserAppeals                    ModerationScoutUserAppeals[]
  ModerationScoutForms           ModerationScoutForms[]
  // Reports
  ReportCommandId                String
  ReportMesageContextId          String
  ReportUserContextId            String
  ImmuneReportRoles              String[]
  NotAllowedToReportRoles        String[]
  SuccssReportMessageId          String
  ReportActions                  String[] // Format: action:<optionalData> | Open Ticket, Send Message, Send DM
  ModerationScoutReports         ModerationScoutReports[]
  ModerationScoutReportModalData ModerationScoutReportModalData[]
  ModerationScoutCases           ModerationScoutCases[]
  GuildId                        String                           @unique
  Guilds                         Guilds                           @relation(fields: [GuildId], references: [GuildId])
}

// TODO: NOT DONE!
model ModerationScoutCases {
  Id                  Int                   @id @default(autoincrement())
  UUID                String                @unique
  MessageId           String
  Channelid           String
  UserId              String
  ModeratorId         String
  Data                Json
  GuildUserModeration GuildUserModeration[]
  ModerationScoutId   String                @unique
  ModerationScout     ModerationScout       @relation(fields: [ModerationScoutId], references: [GuildId])
}

// Appeals
model ModerationScoutForms {
  Id                         Int                          @id @default(autoincrement())
  UUID                       String                       @unique
  Sorting                    String[]
  Actions                    String[] // Format: action:<optionalData> | Open Ticket, Send Message, Send DM, UNBAN (to make tickets required*), Resolve DM
  ModerationScout            ModerationScout              @relation(fields: [UUID], references: [UUID])
  ModerationScoutFormsData   ModerationScoutFormsData[]
  ModerationScoutUserAppeals ModerationScoutUserAppeals[]
}

// Appeals
model ModerationScoutFormsData {
  Id                   Int                  @id @default(autoincrement())
  UUID                 String               @unique
  Type                 String // DropDown, CheckBox, Short Text, Long Text, Spacing, ReadOnly
  Label                String
  Description          String
  Placeholder          String
  OptionData           Json
  ModerationScoutForms ModerationScoutForms @relation(fields: [UUID], references: [UUID])
}

// Appeals
model ModerationScoutUserAppeals {
  Id                    Int                  @id @default(autoincrement())
  UUID                  String               @unique
  Token                 String
  UserId                String
  Case                  String // REPORT, MODERATION, BAN, MUTE, WARN, CUSTOM
  FormId                String
  ModerationScoutFormId String
  Data                  Json
  CratedAt              DateTime
  CreatedBy             String
  ModerationScoutId     String
  ModerationScoutForms  ModerationScoutForms @relation(fields: [ModerationScoutFormId], references: [UUID])
  ModerationScout       ModerationScout      @relation(fields: [UUID], references: [UUID])
}

// Reports
model ModerationScoutReportModalData {
  Id                Int             @id @default(autoincrement())
  UUID              String          @unique
  Name              String
  Placeholder       String?
  Type              Int
  MinLength         Int?
  MaxLength         Int?
  Required          Boolean
  InteractionType   String // MESSAGE_CONTEXT, USER_CONTEXT, COMMAND
  ModerationScoutId String
  ModerationScout   ModerationScout @relation(fields: [UUID], references: [UUID])
}

// Reports
model ModerationScoutReports {
  Id                       Int             @id @default(autoincrement())
  UUID                     String          @unique
  UserId                   String
  SusUserId                String
  Reason                   String?
  Data                     Json?
  IsReportedToBanListAdmin Boolean
  ModeratorUserId          String
  ModerationScout          ModerationScout @relation(fields: [UUID], references: [UUID])
}

// Soon Implemented!
model GuildModeration {
  Id                               Int                               @id @default(autoincrement())
  GuildUserModerationSettingWarn   GuildUserModerationSettingWarn?

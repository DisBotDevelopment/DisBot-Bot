// TODO: Database Migrations checks!!!
generator client {
  provider      = "prisma-client-js"
  output        = "../src/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL")
}

model Guilds {
  Id                          Int                           @id @default(autoincrement())
  GuildId                     String                        @unique
  GuildName                   String
  GuildOwner                  String
  DiscordAddons               DiscordGuildAddon? // DONE
  Giveaways                   Giveaways[] // DONE
  AutoAutoDeletes             GuildAutoDeletes[] // DONE
  AutoPublish                 GuildAutoPublish? // DONE
  AutoReacts                  GuildAutoReacts[] // DONE
  AutoRoles                   GuildAutoRoles[] // DONE
  GuildChannelLinks           GuildChannelLinks[] // DONE
  GuildCommandManger          GuildCommandManger? // DONE
  GuildComponentManager       GuildComponentManager? // DONE
  GuildDisBotAutoModeration   GuildDisBotAutoModeration? // DONE
  GuildFeatureToggle          GuildFeatureToggles? // DONE
  GuildInteractionPermissions GuildInteractionPermissions[]
  GuildLeaveSetup             GuildLeaveSetup? // DONE
  GuildLogging                GuildLogging? // DONE
  GuildLogs                   GuildLogs[] // DONE
  GuildModeration             GuildModeration? // DONE
  Security                    GuildSecurity? // DONE
  SpotifyNotifications        GuildSpotifyNotifications[] // DONE
  TwitchNotifications         GuildTwitchNotifications[] // DONE
  GuildUserModeration         GuildUserModeration[] // DONE
  GuildWelcomeSetup           GuildWelcomeSetup? // DONE
  YoutubeNotifications        GuildYoutubeNotifications[] // DONE
  LevelSettings               LevelSettings? // DONE
  MessageTemplates            MessageTemplates[] // DONE
  ModerationScout             ModerationScout? // DONE
  Polls                       Polls[] // DONE
  TempVoices                  TempVoice? // DONE
  TicketSetups                TicketSetups[] // DONE
}

model GuildCommandManger {
  Id               Int               @id @default(autoincrement())
  Commands         Json[]
  SubCommands      Json[]
  SubCommandGroups Json[]
  ContextMenus     Json[]
  GuildId          String            @unique
  BuildInCommands  BuildInCommands[]
  Guilds           Guilds            @relation(fields: [GuildId], references: [GuildId])
}

model BuildInCommands {
  Id                   Int                @id @default(autoincrement())
  UUID                 String             @unique
  CustomName           String
  Description          String?
  Permissions          String?
  IsEnabled            Boolean?           @default(false)
  CodeName             String
  GuildCommandMangerId String
  GuildCommandMangers  GuildCommandManger @relation(fields: [GuildCommandMangerId], references: [GuildId])
}

model GuildComponentManager {
  Id          Int    @id @default(autoincrement())
  Selectmenus Json[]
  Buttons     Json[]
  Modals      Json[]
  GuildId     String @unique
  Guilds      Guilds @relation(fields: [GuildId], references: [GuildId])
}

model GuildInteractionPermissions {
  Id                            Int      @id @default(autoincrement())
  UUID                          String   @unique
  RoleIds                       String[]
  UserIds                       String[]
  ChannelIds                    String[]
  CustomId                      String?
  CommandName                   String?
  Type                          String
  DisableInternalUserPermission Boolean? @default(false)
  NeedsGuildOwner               Boolean?
  Cooldown                      Int?
  GuildId                       String
  Guilds                        Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoDeletes {
  Id                  Int      @id @default(autoincrement())
  ChannelId           String?
  IsActive            Boolean?
  Time                String?
  UUID                String?  @unique
  WhitelistedMessages String[]
  WhitelistedRoles    String[]
  WhitelistedUsers    String[]
  GuildId             String
  Guilds              Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoPublish {
  Id       Int      @id @default(autoincrement())
  Channels String[]
  GuildId  String   @unique
  Guilds   Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoReacts {
  Id        Int    @id @default(autoincrement())
  ChannelId String
  Emoji     String
  GuildId   String
  Guilds    Guilds @relation(fields: [GuildId], references: [GuildId])
}

model GuildAutoRoles {
  Id      Int    @id @default(autoincrement())
  RoleId  String
  GuildId String
  Guilds  Guilds @relation(fields: [GuildId], references: [GuildId])
}

model ModerationScout {
  Id                             Int                             @id @default(autoincrement())
  UUID                           String                          @unique
  PublicBanListUrl               String?                         @default("https://api.disbot.app/v2/banList")
  AdminBanList                   Json
  CurrentUserModerations         Json[]
  PublicBanListEnabled           Boolean                         @default(false)
  NeedsModeratorApprove          Boolean
  ModeratorRoles                 String[]
  ReportCommandId                String
  ReportMesageContextId          String
  ReportUserContextId            String
  ImmuneReportRoles              String[]
  NotAllowedToReportRoles        String[]
  SuccssReportMessageId          String
  ReportActions                  String[]
  GuildId                        String                          @unique
  Guilds                         Guilds                          @relation(fields: [GuildId], references: [GuildId])
  ModerationScoutCases           ModerationScoutCases?
  ModerationScoutForms           ModerationScoutForms?
  ModerationScoutReportModalData ModerationScoutReportModalData?
  ModerationScoutReports         ModerationScoutReports?
  UserAppeals                    ModerationScoutUserAppeals?
}

model ModerationScoutCases {
  Id                  Int                   @id @default(autoincrement())
  UUID                String                @unique
  MessageId           String
  Channelid           String
  UserId              String
  ModeratorId         String
  Data                Json
  ModerationScoutId   String                @unique
  GuildUserModeration GuildUserModeration[]
  ModerationScout     ModerationScout       @relation(fields: [ModerationScoutId], references: [GuildId])
}

model ModerationScoutForms {
  Id                         Int                          @id @default(autoincrement())
  UUID                       String                       @unique
  Sorting                    String[]
  Actions                    String[]
  ModerationScout            ModerationScout              @relation(fields: [UUID], references: [UUID])
  ModerationScoutFormsData   ModerationScoutFormsData?
  ModerationScoutUserAppeals ModerationScoutUserAppeals[]
}

model ModerationScoutFormsData {
  Id                   Int                  @id @default(autoincrement())
  UUID                 String               @unique
  Type                 String
  Label                String
  Description          String
  Placeholder          String
  OptionData           Json
  ModerationScoutForms ModerationScoutForms @relation(fields: [UUID], references: [UUID])
}

model ModerationScoutUserAppeals {
  Id                    Int                  @id @default(autoincrement())
  UUID                  String               @unique
  Token                 String
  UserId                String
  Case                  String
  FormId                String
  ModerationScoutFormId String
  Data                  Json
  CratedAt              DateTime
  CreatedBy             String
  ModerationScoutId     String
  ModerationScoutForms  ModerationScoutForms @relation(fields: [ModerationScoutFormId], references: [UUID])
  ModerationScout       ModerationScout      @relation(fields: [UUID], references: [UUID])
}

model ModerationScoutReportModalData {
  Id                Int             @id @default(autoincrement())
  UUID              String          @unique
  Name              String
  Placeholder       String?
  Type              Int
  MinLength         Int?
  MaxLength         Int?
  Required          Boolean
  InteractionType   String
  ModerationScoutId String
  ModerationScout   ModerationScout @relation(fields: [UUID], references: [UUID])
}

model ModerationScoutReports {
  Id                       Int             @id @default(autoincrement())
  UUID                     String          @unique
  UserId                   String
  SusUserId                String
  Reason                   String?
  Data                     Json?
  IsReportedToBanListAdmin Boolean
  ModeratorUserId          String
  ModerationScout          ModerationScout @relation(fields: [UUID], references: [UUID])
}

model GuildModeration {
  Id                               Int                               @id @default(autoincrement())
  GuildId                          String                            @unique
  Guilds                           Guilds                            @relation(fields: [GuildId], references: [GuildId])
  GuildUserModerationSettinKick    GuildUserModerationSettinKick?
  GuildUserModerationSettingBan    GuildUserModerationSettingBan?
  GuildUserModerationSettingMute   GuildUserModerationSettingMute?
  GuildUserModerationSettingUnban  GuildUserModerationSettingUnban?
  GuildUserModerationSettingUnmute GuildUserModerationSettingUnmute?
  GuildUserModerationSettingUnwarn GuildUserModerationSettingUnwarn?
  GuildUserModerationSettingWarn   GuildUserModerationSettingWarn?
}

model GuildUserModerationSettingBan {
  Id                           Int             @id @default(autoincrement())
  DefaultReason                String
  AuditLogReason               String
  Duration                     Int
  DeleteProveMessage           Boolean
  NeedReason                   Boolean
  GuildUserModerationSettingId String          @unique
  GuildUserModerationSetting   GuildModeration @relation(fields: [GuildUserModerationSettingId], references: [GuildId])
}

model GuildUserModerationSettingUnban {
  Id                           Int             @id @default(autoincrement())
  DefaultReason                String
  AuditLogReason               String
  NeedReason                   Boolean
  GuildUserModerationSettingId String          @unique
  GuildUserModerationSetting   GuildModeration @relation(fields: [GuildUserModerationSettingId], references: [GuildId])
}

model GuildUserModerationSettinKick {
  Id                           Int             @id @default(autoincrement())
  DefaultReason                String
  AuditLogReason               String
  NeedReason                   Boolean
  GuildUserModerationSettingId String          @unique
  GuildUserModerationSetting   GuildModeration @relation(fields: [GuildUserModerationSettingId], references: [GuildId])
}

model GuildUserModerationSettingWarn {
  Id                           Int             @id @default(autoincrement())
  DefaultReason                String
  AuditLogReason               String
  Duration                     Int
  Actions                      Json[]
  DeleteProveMessage           Boolean
  NeedReason                   Boolean
  GuildUserModerationSettingId String          @unique
  GuildUserModerationSetting   GuildModeration @relation(fields: [GuildUserModerationSettingId], references: [GuildId])
}

model GuildUserModerationSettingUnwarn {
  Id                           Int             @id @default(autoincrement())
  DefaultReason                String
  AuditLogReason               String
  Actions                      Json[]
  NeedReason                   Boolean
  GuildUserModerationSettingId String          @unique
  GuildUserModerationSetting   GuildModeration @relation(fields: [GuildUserModerationSettingId], references: [GuildId])
}

model GuildUserModerationSettingMute {
  Id                           Int             @id @default(autoincrement())
  DefaultReason                String
  AuditLogReason               String
  Duration                     Int
  Actions                      Json[]
  DeleteProveMessage           Boolean
  NeedReason                   Boolean
  UseTimeout                   Boolean
  GuildUserModerationSettingId String          @unique
  GuildUserModerationSetting   GuildModeration @relation(fields: [GuildUserModerationSettingId], references: [GuildId])
}

model GuildUserModerationSettingUnmute {
  Id                           Int             @id @default(autoincrement())
  DefaultReason                String
  AuditLogReason               String
  Actions                      Json
  NeedReason                   Boolean
  GuildUserModerationSettingId String          @unique
  GuildUserModerationSetting   GuildModeration @relation(fields: [GuildUserModerationSettingId], references: [GuildId])
}

model GuildUserModeration {
  Id                   Int                   @id @default(autoincrement())
  UUID                 String                @unique
  Duration             String?
  UserIds              String[]
  Reason               String?
  ModeratorId          String?
  DmMessage            String?
  Type                 String?
  Notes                String[]
  LinkedCaseId         String?
  CreatedAt            DateTime?
  GuildId              String
  Guilds               Guilds                @relation(fields: [GuildId], references: [GuildId])
  ModerationScoutCases ModerationScoutCases? @relation(fields: [LinkedCaseId], references: [UUID])
}

model GuildDisBotAutoModeration {
  Id             Int                                     @id @default(autoincrement())
  GuildId        String                                  @unique
  Guilds         Guilds                                  @relation(fields: [GuildId], references: [GuildId])
  AttachmentSpam GuildDisBotAutoModerationAttachments[]
  BlockInvites   GuildDisBotAutoModerationBlockInvites[]
  BlockLinks     GuildDisBotAutoModerationBlockLinks[]
  BlockedWords   GuildDisBotAutoModerationBlockedWords[]
  EmojiSpam      GuildDisBotAutoModerationEmojis[]
  MentionSpam    GuildDisBotAutoModerationMentions[]
  MessageSpam    GuildDisBotAutoModerationMessages[]
}

model GuildDisBotAutoModerationMessages {
  Id                          Int                       @id @default(autoincrement())
  UUID                        String                    @unique
  RegexPetterns               String[]
  ExcludedChannels            String[]
  ExcludedRoles               String[]
  Trigger                     Json
  Actions                     Json[]
  GuildDisBotAutoModerationId String
  GuildDisBotAutoModeration   GuildDisBotAutoModeration @relation(fields: [GuildDisBotAutoModerationId], references: [GuildId])
}

model GuildDisBotAutoModerationMentions {
  Id                          Int                       @id @default(autoincrement())
  UUID                        String                    @unique
  RegexPetterns               String[]
  ExcludedChannels            String[]
  ExcludedRoles               String[]
  Trigger                     Json
  Actions                     Json[]
  GuildDisBotAutoModerationId String
  GuildDisBotAutoModeration   GuildDisBotAutoModeration @relation(fields: [GuildDisBotAutoModerationId], references: [GuildId])
}

model GuildDisBotAutoModerationAttachments {
  Id                          Int                       @id @default(autoincrement())
  UUID                        String                    @unique
  RegexPetterns               String[]
  ExcludedChannels            String[]
  ExcludedRoles               String[]
  Trigger                     Json
  Actions                     Json[]
  GuildDisBotAutoModerationId String
  GuildDisBotAutoModeration   GuildDisBotAutoModeration @relation(fields: [GuildDisBotAutoModerationId], references: [GuildId])
}

model GuildDisBotAutoModerationEmojis {
  Id                          Int                       @id @default(autoincrement())
  UUID                        String                    @unique
  RegexPetterns               String[]
  ExcludedChannels            String[]
  ExcludedRoles               String[]
  Trigger                     Json
  Actions                     Json[]
  GuildDisBotAutoModerationId String
  GuildDisBotAutoModeration   GuildDisBotAutoModeration @relation(fields: [GuildDisBotAutoModerationId], references: [GuildId])
}

model GuildDisBotAutoModerationBlockedWords {
  Id                          Int                       @id @default(autoincrement())
  UUID                        String                    @unique
  RegexPetterns               String[]
  ExcludedChannels            String[]
  ExcludedRoles               String[]
  Trigger                     Json
  Actions                     Json[]
  GuildDisBotAutoModerationId String
  GuildDisBotAutoModeration   GuildDisBotAutoModeration @relation(fields: [GuildDisBotAutoModerationId], references: [GuildId])
}

model GuildDisBotAutoModerationBlockLinks {
  Id                          Int                       @id @default(autoincrement())
  UUID                        String                    @unique
  RegexPetterns               String[]
  ExcludedChannels            String[]
  ExcludedRoles               String[]
  ExcludedLinks               String[]
  Trigger                     Json
  Actions                     Json[]
  GuildDisBotAutoModerationId String
  GuildDisBotAutoModeration   GuildDisBotAutoModeration @relation(fields: [GuildDisBotAutoModerationId], references: [GuildId])
}

model GuildDisBotAutoModerationBlockInvites {
  Id                          Int                       @id @default(autoincrement())
  UUID                        String                    @unique
  RegexPetterns               String[]
  ExcludedChannels            String[]
  ExcludedRoles               String[]
  ExcludedGuildIds            String[]
  Trigger                     Json
  Actions                     Json[]
  GuildDisBotAutoModerationId String
  GuildDisBotAutoModeration   GuildDisBotAutoModeration @relation(fields: [GuildDisBotAutoModerationId], references: [GuildId])
}

model GuildChannelLinks {
  Id                       Int                         @id @default(autoincrement())
  UUID                     String                      @unique
  ChannelId                String                      @unique
  WebhookUrl               String                      @unique
  SyncFlags                String[]
  LinkedWith               String[]
  UsersCanSelectIds        String[]
  GuildId                  String
  Guilds                   Guilds                      @relation(fields: [GuildId], references: [GuildId])
  SyncedChannelLinkMessage SyncedChannelLinkMessages[]
}

model SyncedChannelLinkMessages {
  Id               Int               @id @default(autoincrement())
  GuildId          String
  UserMessageId    String
  WebhookMessageId String
  WebhookUrl       String
  ChannelId        String
  ChannelLinkId    String
  ChannelLinks     GuildChannelLinks @relation(fields: [ChannelLinkId], references: [UUID])
}

model DiscordGuildAddon {
  Id            Int      @id @default(autoincrement())
  OnlyMedia     String[]
  NoLinkEmbeds  String[]
  InvitesPaused Boolean
  GuildId       String   @unique
  Guilds        Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model Giveaways {
  Id                    Int       @id @default(autoincrement())
  UUID                  String    @unique
  MessageId             String    @unique
  ChannelId             String?
  Prize                 String
  Winners               Int
  Time                  String
  CreatedAt             DateTime
  Ended                 Boolean
  EndedAt               DateTime?
  EndedBy               String?
  Paused                Boolean
  EndedMessage          String?
  Rerolled              Boolean
  WinnerIds             String[]
  WinnerMessageTemplate String?
  HostedBy              String
  MessageTemplate       String?
  Content               String?
  Entrys                String[]
  Requirements          String[]
  GuildId               String
  Guilds                Guilds    @relation(fields: [GuildId], references: [GuildId])
}

model TempVoice {
  Id                          Int               @id @default(autoincrement())
  UserInviteMessageTemplateId String?
  ModeratorUserIds            String[]
  TempVoiceLogChannelId       String?
  GuildId                     String            @unique
  Guilds                      Guilds            @relation(fields: [GuildId], references: [GuildId], onDelete: NoAction, onUpdate: NoAction, map: "TempVoice_Guilds_fkey")
  TempVoiceConfigs            TempVoiceConfig[]
  TempVoicePresets            TempVoicePreset[]
}

model TempVoiceConfig {
  Id                      Int                 @id @default(autoincrement())
  UUID                    String              @unique
  CreatorChannel          String?
  ChannelCategory         String?
  ManageMessageTemplateId String?
  IsManageEnalbed         Boolean             @default(true)
  TempVoicePresetId       String              @unique
  TempVoiceId             String
  TempVoiceChannels       TempVoiceChannels[]
  TempVoicePreset         TempVoicePreset     @relation(fields: [TempVoicePresetId], references: [UUID], onDelete: NoAction, onUpdate: NoAction, map: "TempVoiceConfig_Preset_fkey")
  TempVoice               TempVoice           @relation(fields: [TempVoiceId], references: [GuildId], onDelete: NoAction, onUpdate: NoAction, map: "TempVoiceConfig_TempVoice_fkey")
}

model TempVoicePreset {
  Id                             Int                                   @id @default(autoincrement())
  UUID                           String                                @unique
  ChannelName                    String?
  ChannelLimit                   Int?
  ChannelRegion                  String?
  ChannelBitRate                 String?
  UserInviteType                 String?                               @default("ping")
  SendLogsInTempChannel          Boolean?                              @default(true)
  BlacklistRoleId                String?
  ManageComponents               String[]
  OwnerAllowedDiscordPermissions String[]
  OwnerDeniedDiscordPermissions  String[]
  TempVoiceId                    String
  TempVoiceConfigs               TempVoiceConfig?
  TempVoice                      TempVoice                             @relation(fields: [TempVoiceId], references: [GuildId], onDelete: NoAction, onUpdate: NoAction, map: "TempVoicePreset_TempVoice_fkey")
  RolePermissions                TempVoicePresetDiscordRolePermission?
}

model TempVoicePresetDiscordRolePermission {
  Id                        Int             @id @default(autoincrement())
  RoleId                    String
  AllowedDiscordPermissions String[]
  DeniedDiscordPermissions  String[]
  TempVoicePresetId         String          @unique
  TempVoicePreset           TempVoicePreset @relation(fields: [TempVoicePresetId], references: [UUID], onDelete: NoAction, onUpdate: NoAction, map: "Permission_Preset_fkey")
}

model TempVoiceChannels {
  Id                      Int                     @id @default(autoincrement())
  GuildId                 String
  ChannelId               String                  @unique
  OwnerId                 String                  @unique
  TempVoiceConfigId       String
  TempVoiceChannelMembers TempVoiceChannelMember?
  TempVoiceConfig         TempVoiceConfig         @relation(fields: [TempVoiceConfigId], references: [UUID], onDelete: NoAction, onUpdate: NoAction, map: "Channel_Config_fkey")
}

model TempVoiceChannelMember {
  Id                Int               @id @default(autoincrement())
  UserId            String
  ChannelId         String            @unique
  Permissions       String[]          @default(["kick", "name", "limit", "look", "unlook"])
  TempVoiceChannels TempVoiceChannels @relation(fields: [ChannelId], references: [ChannelId], onDelete: NoAction, onUpdate: NoAction, map: "Member_Channel_fkey")
}

model GuildLeaveSetup {
  Id                Int             @id @default(autoincrement())
  MessageTemplateId String?
  ChannelId         String          @unique
  Image             Boolean?
  GuildId           String          @unique
  Guilds            Guilds          @relation(fields: [GuildId], references: [GuildId])
  ImageData         LeaveImageData?
}

model LeaveImageData {
  Id                Int             @id @default(autoincrement())
  Title             String
  Text              String
  Subtitle          String
  Background        String
  Theme             String
  Color             String
  Gradient          String
  GuildLeaveSetupId String          @unique
  GuildLeaveSetup   GuildLeaveSetup @relation(fields: [GuildLeaveSetupId], references: [GuildId])
}

model GuildWelcomeSetup {
  Id                Int               @id @default(autoincrement())
  MessageTemplateId String?
  ChannelId         String
  Image             Boolean
  GuildId           String            @unique
  Guilds            Guilds            @relation(fields: [GuildId], references: [GuildId])
  ImageData         WelcomeImageData?
}

model WelcomeImageData {
  Id                  Int               @id @default(autoincrement())
  Title               String
  Text                String
  Subtitle            String
  Background          String
  Theme               String
  Color               String
  Gradient            String
  GuildWelcomeSetupId String            @unique
  GuildWelcomeSetup   GuildWelcomeSetup @relation(fields: [GuildWelcomeSetupId], references: [GuildId])
}

model GuildLogging {
  Id          Int     @id @default(autoincrement())
  AutoMod     String?
  Channel     String?
  Emoji       String?
  Guild       String?
  Integration String?
  Invite      String?
  Member      String?
  Message     String?
  Moderation  String?
  Reaction    String?
  Role        String?
  SoundBoard  String?
  Sticker     String?
  Thread      String?
  Voice       String?
  Webhook     String?
  Ban         String?
  Kick        String?
  Poll        String?
  Stage       String?
  Event       String?
  GuildId     String  @unique
  Guilds      Guilds  @relation(fields: [GuildId], references: [GuildId])
}

model GuildLogs {
  Id         Int      @id @default(autoincrement())
  UUID       String   @unique
  Notes      String[]
  LogMessage String
  LogJSON    String
  GuildId    String
  Guilds     Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model MessageTemplates {
  Id                    Int      @id @default(autoincrement())
  Content               String?
  EmbedJSON             String?
  OtherEmbeds           String[]
  Name                  String   @unique
  GuildId               String
  ComponentJSON         String?
  IsComponentsV2Message Boolean  @default(false)
  Guilds                Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildSecurity {
  Id                  Int                 @id @default(autoincrement())
  InviteLoggingActive String?
  MaxAccountAge       Int?
  GuildId             String              @unique
  Guilds              Guilds              @relation(fields: [GuildId], references: [GuildId])
  VerificationGates   VerificationGates[]
}

model VerificationGates {
  Id                 Int                           @id @default(autoincrement())
  UUID               String                        @unique
  ChannelId          String
  MessageId          String
  Action             String?
  ActionType         String?
  Roles              String[]
  VerifiedUsers      String[]
  CreatedAt          DateTime
  Active             Boolean?
  SecurityId         String
  VerificationGates  GuildSecurity                 @relation(fields: [SecurityId], references: [GuildId])
  ChannelPermissions VerificationGatesPermission[]
}

model VerificationGatesPermission {
  Id                 Int               @id @default(autoincrement())
  Permission         String[]
  ChannelId          String
  VerificationGateId String
  VerificationGates  VerificationGates @relation(fields: [VerificationGateId], references: [UUID])
}

model GuildSpotifyNotifications {
  Id                Int      @id @default(autoincrement())
  UUID              String   @unique
  ShowId            String
  ChannelId         String
  Latests           String[]
  MessageTemplateId String
  PingRoles         String[]
  GuildId           String
  Guilds            Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model Polls {
  Id                Int           @id @default(autoincrement())
  UUID              String        @unique
  MessageId         String?
  ChannelId         String?
  MessageTemplateId String
  MultiAnswers      Int
  Time              Int?
  Entrys            String[]
  Type              Int
  Requirements      String[]
  CreatedAt         DateTime
  GuildId           String
  PollAnswers       PollAnswers[]
  PollOptions       PollOptions[]
  Guilds            Guilds        @relation(fields: [GuildId], references: [GuildId])
}

model PollOptions {
  Id          Int           @id @default(autoincrement())
  UUID        String        @unique
  Label       String
  Description String
  Emoji       String?
  UserIds     String[]
  PollId      String
  PollAnswers PollAnswers[]
  Polls       Polls         @relation(fields: [PollId], references: [UUID])
}

model PollAnswers {
  Id           Int         @id @default(autoincrement())
  UUID         String      @unique
  PollOptionId String
  PollId       String
  Polls        Polls       @relation(fields: [PollId], references: [UUID])
  PollOptions  PollOptions @relation(fields: [PollOptionId], references: [UUID])
}

model TicketSetups {
  Id                               Int                 @id @default(autoincrement())
  CategoryId                       String?
  ChannelType                      Int?
  CustomId                         String              @unique
  TicketChannelName                String?
  EnableTicketsOnlyFromTime        String?
  MessageTemplateId                String?
  TicketBlacklistRoles             String[]
  TranscriptChannelId              String?
  HasModal                         Boolean?
  ModalTitle                       String?
  OnlyClaimMode                    Boolean?
  TicketLimit                      Int?
  UserDMWhenCloseMessageTemplateId String?
  WithTicketFeedback               Boolean?
  TicketFeedbackChannelId          String?
  TicketCreationCooldownPerUser    Int?
  AutoCloseAfterInactivity         Int?
  AutoCloseAfterTime               Int?
  AutoAssignHandler                String?
  AutoReplyMessageTemplateId       String?
  TicketRateLimit                  String?
  TicketStatusMessageTemplateId    String?
  TicketStatusMessageId            String?
  TicketStatusChannelId            String?
  AutoCloseAction                  String[]
  OldTicketCategoryId              String?
  RequiredRoles                    String[]
  SlashCommandId                   String?
  SlashCommandName                 String?
  SlashCommandDescription          String?
  TextCommandName                  String?
  SendTranscriptToUser             Boolean?
  GuildId                          String
  TicketSettings                   String[]
  ModalOptions                     TicketModalData[]
  TicketPermissions                TicketPermissions[]
  Guilds                           Guilds              @relation(fields: [GuildId], references: [GuildId])
  Tickets                          Tickets[]
}

model TicketModalData {
  Id            Int          @id @default(autoincrement())
  UUID          String       @unique
  Name          String
  Placeholder   String?
  Type          Int
  MinLength     Int?
  MaxLength     Int?
  Required      Boolean
  TicketSetupId String
  TicketSetup   TicketSetups @relation(fields: [TicketSetupId], references: [CustomId])
}

model TicketPermissions {
  Id                        Int          @id @default(autoincrement())
  UUID                      String       @unique
  DiscordUserId             String?
  DiscordRoleId             String?
  HasShadowPing             Boolean?
  IsHandler                 Boolean      @default(false)
  TicketPermissions         String[]
  AllowedDiscordPermissions BigInt?
  DeniedDiscordPermissions  BigInt?
  TicketSetupId             String
  TicketSetup               TicketSetups @relation(fields: [TicketSetupId], references: [CustomId])
}

model Tickets {
  Id                               Int             @id @default(autoincrement())
  TicketId                         String          @unique
  CreatedAt                        DateTime
  ClosedAt                         DateTime?
  IsClosed                         Boolean         @default(false)
  GuildId                          String
  ChannelType                      Int
  ChannelId                        String?
  ThreadId                         String?
  LastMessageId                    String?
  IsClaimed                        Boolean         @default(false)
  IsArchived                       Boolean?        @default(false)
  ArchiveMessageId                 String?
  UserWhoHasClaimedId              String?
  IsLocked                         Boolean?
  TicketOwnerId                    String
  AddedMemberIds                   String[]
  TranscriptChannelId              String?
  TranscriptHTML                   String?
  TranscriptJSON                   String?
  TicketNotes                      String[]
  SendTranscriptToUser             Boolean?
  IsAutoDone                       Boolean?        @default(false)
  OldTicketCategoryId              String?
  AutoCloseAction                  String[]
  CloseActionReason                String?
  AutoReplyMessageTemplateId       String?
  AutoAssignHandler                String?
  TicketFeedbackChannelId          String?
  WithTicketFeedback               Boolean?
  UserDMWhenCloseMessageTemplateId String?
  OnlyClaimMode                    Boolean?
  TicketSetupId                    String
  TicketFeedback                   TicketFeedback?
  TicketSetup                      TicketSetups    @relation(fields: [TicketSetupId], references: [CustomId])
}

model TicketFeedback {
  Id          Int       @id @default(autoincrement())
  TicketId    String    @unique
  Rating      Int?
  Comment     String?
  Sent        Boolean   @default(false)
  SubmittedAt DateTime? @default(now())
  Ticket      Tickets   @relation(fields: [TicketId], references: [TicketId])
}

model GuildFeatureToggles {
  Id                 Int     @id @default(autoincrement())
  LevelEnabled       Boolean @default(false)
  WecomeEnabled      Boolean @default(false)
  LeaveEnabled       Boolean @default(false)
  AutoreactEnabled   Boolean @default(false)
  AutopublishEnabled Boolean @default(false)
  ChatfilterEnabled  Boolean @default(false)
  AutorolesEnabled   Boolean @default(false)
  LoggingEnabled     Boolean @default(false)
  TwitchEnabled      Boolean @default(false)
  YoutubeEnabled     Boolean @default(false)
  SpotifyEnabled     Boolean @default(false)
  GuildId            String  @unique
  Guilds             Guilds  @relation(fields: [GuildId], references: [GuildId])
}

model GuildTwitchNotifications {
  Id                Int      @id @default(autoincrement())
  UUID              String   @unique
  TwitchChannelName String
  ChannelId         String
  Live              Boolean
  MessageTemplateId String
  PingRoles         String[]
  GuildId           String
  Guilds            Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model GuildYoutubeNotifications {
  Id                Int      @id @default(autoincrement())
  YoutubeChannelId  String
  ChannelId         String
  Latest            String[]
  MessageTemplateId String
  PingRoles         String[]
  UUID              String   @unique
  GuildId           String
  Guilds            Guilds   @relation(fields: [GuildId], references: [GuildId])
}

model LevelSettings {
  Id                           Int          @id @default(autoincrement())
  LevelUpChannelId             String?
  LeaderboardMessageTemplateId String?
  LeaderboardDisplayAmount     Int?
  RequiredXPForFirstLevel      Int?
  MessageXPRange               String?
  VoiceXPRange                 String?
  VoiceXPCooldown              String?
  ExcludedChannelIds           String[]
  ExcludeUserIds               String[]
  ExcludeRoleIds               String[]
  GuildId                      String       @unique
  LevelUpMessageTemplateId     String?
  IsLevelModuleEnabled         Boolean      @default(false)
  IsMessageXPEnabled           Boolean?     @default(false)
  IsVoiceXPEnabled             Boolean?     @default(false)
  MessageXPCooldown            String?
  MessageXPType                String[]
  RequiredXPFormular           String?
  LevelUpMessageType           String?
  LevelUserInfoMessageTemplate String?
  XPStreaksMessageType         String?
  XPStreaksMessageChannelId    String?
  XPStreaksIncreaseType        String[]
  XPDropsMessageTemplate       String?
  LevelRoles                   LevelRoles[]
  Guilds                       Guilds       @relation(fields: [GuildId], references: [GuildId])
  Levels                       Levels[]
  XPDrops                      XPDrops[]
  XPStreaks                    XPStreaks[]
}

model XPDrops {
  Id                 Int           @id @default(autoincrement())
  GuildId            String
  XPRange            String?
  TimeToRespawn      String?
  ChannelIds         String[]
  ClaimAmount        Int?
  ExpireTime         String?
  UUID               String        @unique
  LastSpawned        String?
  MessageIdsToDelete String[]
  LevelSettings      LevelSettings @relation(fields: [GuildId], references: [GuildId])
}

model XPStreaks {
  Id                Int           @id @default(autoincrement())
  Days              Int?
  Nickname          String?
  BonusLevels       Int?
  BonusXP           Int?
  MessageTemplateId String?
  Multiplier        Int?
  RoleRewardIds     String[]
  GuildId           String
  LevelSettings     LevelSettings @relation(fields: [GuildId], references: [GuildId])
}

model LevelRoles {
  Id            Int           @id @default(autoincrement())
  Level         Int?
  Multiplier    Int?
  RoleId        String        @unique
  GuildId       String
  Types         String[]
  LevelSettings LevelSettings @relation(fields: [GuildId], references: [GuildId])
}

model Levels {
  Id                 Int           @id @default(autoincrement())
  XP                 String?
  Level              Int?
  UserId             String
  GuildId            String
  UUID               String        @unique
  ClaimedXPDrops     String[]
  CurrentStreakDay   Int?
  RequiredXp         String?
  LastXPStreakUpdate String?
  LevelSettings      LevelSettings @relation(fields: [GuildId], references: [GuildId])
  Users              Users         @relation(fields: [UserId], references: [UserId])
}

model Users {
  Id           Int            @id @default(autoincrement())
  Username     String
  UserId       String         @unique
  Votes        Int            @default(0)
  GloablVotes  Int            @default(0)
  LastVote     DateTime?
  CustomerBots Int            @default(1)
  BackupCount  Int            @default(10000)
  Apis         Apis?
  GuildBackups GuildBackups[]
  Levels       Levels[]
  Vanitys      Vanitys[]
}

model Apis {
  Id               Int      @id @default(autoincrement())
  Flags            String[]
  AccessibleGuilds String[]
  Key              String   @unique
  UserId           String   @unique
  Users            Users    @relation(fields: [UserId], references: [UserId])
}

model GuildBackups {
  Id         Int      @id @default(autoincrement())
  BackupJSON Json
  CreatedAt  DateTime
  UUID       String   @unique
  Name       String
  GuildId    String
  UserId     String
  Users      Users    @relation(fields: [UserId], references: [UserId])
}

model Vanitys {
  Id                   Int             @id @default(autoincrement())
  UUID                 String          @unique
  Slug                 String          @unique
  Host                 String
  GuildId              String
  Invite               String
  InDiscovery          Boolean?        @default(false)
  IsBannedFromDiscover Boolean?        @default(false)
  CreatedAt            DateTime
  UserId               String
  Analytics            VanityAnalytic?
  Embed                VanityEmbed?
  Users                Users           @relation(fields: [UserId], references: [UserId])
}

model VanityEmbed {
  Id           Int                @id @default(autoincrement())
  Title        String
  Description  String
  Color        String
  ImageUrl     String?
  ThumbnailUrl String?
  VanityId     String             @unique
  Vanitys      Vanitys            @relation(fields: [VanityId], references: [UUID])
  Author       VanityEmbedAuthor?
}

model VanityEmbedAuthor {
  Id             Int         @id @default(autoincrement())
  Name           String?
  URL            String?
  IconURL        String?
  VanityEmbedsId String      @unique
  VanityEmbeds   VanityEmbed @relation(fields: [VanityEmbedsId], references: [VanityId])
}

model VanityAnalytic {
  Id                 Int                         @id @default(autoincrement())
  Click              Int
  TrackInviteWithLog String?
  TrackMessageId     String?
  Update             DateTime?
  UniqueClick        Int?
  JoinedWithCode     Int?
  LoggedIPs          String[]
  VanityId           String                      @unique
  Vanitys            Vanitys                     @relation(fields: [VanityId], references: [UUID])
  Latest30Days       VanityAnalyticsLatest30Day?
}

model VanityAnalyticsLatest30Day {
  Id                Int            @id @default(autoincrement())
  Click             Int?
  UniqueClick       Int?
  Date              DateTime?
  JoinedWithCode    Int?
  VanityAnalyticsId String         @unique
  VanityAnalytics   VanityAnalytic @relation(fields: [VanityAnalyticsId], references: [VanityId])
}

model DisBot {
  Id           Int    @id @default(autoincrement())
  Logs         Json[]
  SpotifyToken String
  TwitchToken  String
  Version      String
  GetConf      String @unique
}

@using DisBot.Dashboard.Client.UI.Components.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using ShadcnBlazor.Extras.Toasts
@using ShadcnBlazor.Portals
<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFound)">
    <Found Context="routeData">
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <Authorizing>
                <Authenticating/>
            </Authorizing>
            <NotAuthorized Context="authRouteViewContext">
                @if (authRouteViewContext.User.Identity?.IsAuthenticated ?? false)
                {
                    <AccessDenied/>
                }
                else
                {
                    <Authentication/>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>

<PortalOutlet/>
<ToastLauncher/>
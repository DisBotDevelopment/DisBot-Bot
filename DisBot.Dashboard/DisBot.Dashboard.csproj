<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LucideBlazor" Version="1.0.4" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.6" PrivateAssets="all" />
        <PackageReference Include="Microsoft.DotNet.HotReload.WebAssembly.Browser" Version="10.0.202" />
        <PackageReference Include="ShadcnBlazor" Version="1.0.14" />
        <PackageReference Include="Spectre.Console" Version="0.55.2" />
        <PackageReference Include="Spectre.Console.Json" Version="0.55.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DisBot.Shared\DisBot.Shared.csproj" />
    </ItemGroup>

</Project>
